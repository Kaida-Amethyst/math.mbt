///|
fn atanhf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    atanhf_mpfr_cases_0(),
    atanhf_mpfr_cases_1(),
    atanhf_mpfr_cases_2(),
    atanhf_mpfr_cases_3(),
    atanhf_mpfr_cases_4(),
    atanhf_mpfr_cases_5(),
    atanhf_mpfr_cases_6(),
    atanhf_mpfr_cases_7(),
    atanhf_mpfr_cases_8(),
    atanhf_mpfr_cases_9(),
    atanhf_mpfr_cases_10(),
    atanhf_mpfr_cases_11(),
    atanhf_mpfr_cases_12(),
    atanhf_mpfr_cases_13(),
  ]
}

///|
fn atanhf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "atanhf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in atanhf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.atanhf(input)
      let error = atanhf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "atanhf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core atanhf meets the oracle bound over the corpus" {
  for cases in atanhf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.atanhf(input)
      assert_true(atanhf_oracle_ulp_error(expected, actual) <= 1U)
    }
  }
}

///|
test "atanhf is monotonic and odd over its real domain" {
  let mut previous : Float = 0.0
  let mut have_previous = false
  for cases in atanhf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if (input_bits & 0x7fffffffU) <= 0x3f800000U {
        let actual = @math.atanhf(input)
        assert_true(!actual.is_nan())
        let opposite = @math.atanhf(-input)
        assert_eq(
          opposite.reinterpret_as_uint(),
          (-actual).reinterpret_as_uint(),
        )
        if have_previous {
          assert_true(previous <= actual)
        }
        previous = actual
        have_previous = true
      }
    }
  }
}
