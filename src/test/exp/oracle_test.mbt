///|
let exp_mpfr_case_groups : Array[Array[(UInt64, UInt64)]] = [
  exp_mpfr_cases_0, exp_mpfr_cases_1, exp_mpfr_cases_2, exp_mpfr_cases_3, exp_mpfr_cases_4,
  exp_mpfr_cases_5, exp_mpfr_cases_6, exp_mpfr_cases_7, exp_mpfr_cases_8, exp_mpfr_cases_9,
  exp_mpfr_cases_10, exp_mpfr_cases_11, exp_mpfr_cases_12,
]

///|
fn exp_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "exp agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0UL
  for cases in exp_mpfr_case_groups {
    for pair in cases {
      let (input_bits, expect_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expect = expect_bits.reinterpret_as_double()
      let actual = @math.exp(input)
      let error = exp_oracle_ulp_error(expect, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1UL {
        println(
          "exp oracle mismatch: input_bits=\{input_bits}, expect_bits=\{expect_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1UL)
}

///|
test "exp range and monotonicity over the oracle corpus" {
  let mut previous = 0.0
  let mut have_previous = false
  for cases in exp_mpfr_case_groups {
    for pair in cases {
      let (input_bits, _) = pair
      let actual = @math.exp(input_bits.reinterpret_as_double())
      assert_true(!actual.is_nan())
      assert_eq(actual.reinterpret_as_uint64() >> 63, 0UL)
      if have_previous {
        assert_true(previous <= actual)
      }
      previous = actual
      have_previous = true
    }
  }
}
