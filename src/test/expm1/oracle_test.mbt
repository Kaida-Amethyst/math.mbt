///|
fn expm1_mpfr_case_groups() -> Array[Array[(UInt64, UInt64)]] {
  [
    expm1_mpfr_cases_0(),
    expm1_mpfr_cases_1(),
    expm1_mpfr_cases_2(),
    expm1_mpfr_cases_3(),
    expm1_mpfr_cases_4(),
    expm1_mpfr_cases_5(),
    expm1_mpfr_cases_6(),
    expm1_mpfr_cases_7(),
    expm1_mpfr_cases_8(),
    expm1_mpfr_cases_9(),
    expm1_mpfr_cases_10(),
    expm1_mpfr_cases_11(),
    expm1_mpfr_cases_12(),
    expm1_mpfr_cases_13(),
    expm1_mpfr_cases_14(),
    expm1_mpfr_cases_15(),
  ]
}

///|
fn expm1_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "expm1 agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0UL
  for cases in expm1_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @math.expm1(input)
      let error = expm1_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1UL {
        println(
          "expm1 oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1UL)
}

///|
test "MoonBit Core expm1 meets the oracle bound over the corpus" {
  for cases in expm1_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @core_math.expm1(input)
      assert_true(expm1_oracle_ulp_error(expected, actual) <= 1UL)
    }
  }
}

///|
test "expm1 range and monotonicity over the oracle corpus" {
  let mut previous : Double = 0.0
  let mut have_previous = false
  for cases in expm1_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = input_bits.reinterpret_as_double()
      let actual = @math.expm1(input)
      assert_true(!actual.is_nan())
      assert_true(actual >= -1.0)
      if have_previous {
        assert_true(previous <= actual)
      }
      previous = actual
      have_previous = true
    }
  }
}
