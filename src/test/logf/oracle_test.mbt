///|
fn logf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    logf_mpfr_cases_0(),
    logf_mpfr_cases_1(),
    logf_mpfr_cases_2(),
    logf_mpfr_cases_3(),
    logf_mpfr_cases_4(),
    logf_mpfr_cases_5(),
    logf_mpfr_cases_6(),
    logf_mpfr_cases_7(),
    logf_mpfr_cases_8(),
    logf_mpfr_cases_9(),
    logf_mpfr_cases_10(),
    logf_mpfr_cases_11(),
    logf_mpfr_cases_12(),
  ]
}

///|
fn logf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "logf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in logf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.logf(input)
      let error = logf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "logf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core logf meets the oracle bound over the corpus" {
  for cases in logf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.lnf(input)
      assert_true(logf_oracle_ulp_error(expected, actual) <= 1U)
    }
  }
}

///|
test "logf is monotonic over its positive domain" {
  let mut previous : Float = 0.0
  let mut have_previous = false
  for cases in logf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if input > 0.0 {
        let actual = @math.logf(input)
        assert_true(!actual.is_nan())
        if have_previous {
          assert_true(previous <= actual)
        }
        previous = actual
        have_previous = true
      }
    }
  }
}
