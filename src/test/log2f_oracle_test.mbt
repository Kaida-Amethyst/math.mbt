///|
fn log2f_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    log2f_mpfr_cases_0(),
    log2f_mpfr_cases_1(),
    log2f_mpfr_cases_2(),
    log2f_mpfr_cases_3(),
    log2f_mpfr_cases_4(),
    log2f_mpfr_cases_5(),
    log2f_mpfr_cases_6(),
    log2f_mpfr_cases_7(),
    log2f_mpfr_cases_8(),
    log2f_mpfr_cases_9(),
    log2f_mpfr_cases_10(),
    log2f_mpfr_cases_11(),
    log2f_mpfr_cases_12(),
  ]
}

///|
fn log2f_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "log2f agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in log2f_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.log2f(input)
      let error = log2f_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "log2f oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "log2f is monotonic over its positive domain" {
  let mut previous : Float = 0.0
  let mut have_previous = false
  for cases in log2f_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if input > 0.0 {
        let actual = @math.log2f(input)
        assert_true(!actual.is_nan())
        if have_previous {
          assert_true(previous <= actual)
        }
        previous = actual
        have_previous = true
      }
    }
  }
}
