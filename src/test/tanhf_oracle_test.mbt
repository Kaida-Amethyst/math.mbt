///|
fn tanhf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    tanhf_mpfr_cases_0(),
    tanhf_mpfr_cases_1(),
    tanhf_mpfr_cases_2(),
    tanhf_mpfr_cases_3(),
    tanhf_mpfr_cases_4(),
    tanhf_mpfr_cases_5(),
    tanhf_mpfr_cases_6(),
  ]
}

///|
fn tanhf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "tanhf agrees with the MPFR oracle within 2 ULP" {
  let mut maximum_error = 0U
  for cases in tanhf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.tanhf(input)
      let error = tanhf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 2U {
        println(
          "tanhf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 2U)
}

///|
test "MoonBit Core tanhf meets the oracle bound over the corpus" {
  for cases in tanhf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.tanhf(input)
      assert_true(tanhf_oracle_ulp_error(expected, actual) <= 2U)
    }
  }
}

///|
test "tanhf range and monotonicity over the oracle corpus" {
  let mut previous : Float = 0.0
  let mut have_previous = false
  for cases in tanhf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let actual = @math.tanhf(input)
      assert_true(!actual.is_nan())
      assert_true(actual >= -1.0)
      assert_true(actual <= 1.0)
      let opposite = @math.tanhf(-input)
      assert_eq(opposite.reinterpret_as_uint(), (-actual).reinterpret_as_uint())
      if have_previous {
        assert_true(previous <= actual)
      }
      previous = actual
      have_previous = true
    }
  }
}
