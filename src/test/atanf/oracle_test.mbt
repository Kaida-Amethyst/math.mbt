    (0x7f7136d6U, 0x3fc90fdbU),
    (0x7f76d83eU, 0x3fc90fdbU),
    (0x7f77ad70U, 0x3fc90fdbU),
    (0x7f7ffffbU, 0x3fc90fdbU),
    (0x7f7ffffcU, 0x3fc90fdbU),
    (0x7f7ffffdU, 0x3fc90fdbU),
    (0x7f7ffffeU, 0x3fc90fdbU),
    (0x7f7fffffU, 0x3fc90fdbU),
    (0x7f800000U, 0x3fc90fdbU),
  ]
}

///|
fn atanf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    atanf_mpfr_cases_0(),
    atanf_mpfr_cases_1(),
    atanf_mpfr_cases_2(),
    atanf_mpfr_cases_3(),
    atanf_mpfr_cases_4(),
    atanf_mpfr_cases_5(),
    atanf_mpfr_cases_6(),
    atanf_mpfr_cases_7(),
    atanf_mpfr_cases_8(),
    atanf_mpfr_cases_9(),
    atanf_mpfr_cases_10(),
    atanf_mpfr_cases_11(),
    atanf_mpfr_cases_12(),
    atanf_mpfr_cases_13(),
    atanf_mpfr_cases_14(),
  ]
}

///|
fn atanf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "atanf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in atanf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.atanf(input)
      let error = atanf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "atanf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core atanf meets the oracle bound over the corpus" {
  for cases in atanf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.atanf(input)
      assert_true(atanf_oracle_ulp_error(expected, actual) <= 1U)
    }
  }
}

///|
test "atanf is monotonic and odd over the extended real line" {
  let mut previous : Float = 0.0
  let mut previous_input_bits = 0U
  let mut have_previous = false
  for cases in atanf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let actual = @math.atanf(input)
      assert_true(!actual.is_nan())
      let opposite = @math.atanf(-input)
      assert_eq(opposite.reinterpret_as_uint(), (-actual).reinterpret_as_uint())
      if have_previous {
        if previous > actual {
          println(
            "atanf monotonicity mismatch: previous_input_bits=\{previous_input_bits}, input_bits=\{input_bits}, previous_result_bits=\{previous.reinterpret_as_uint()}, result_bits=\{actual.reinterpret_as_uint()}",
          )
          assert_true(false)
        }
      }
      previous = actual
      previous_input_bits = input_bits
      have_previous = true
    }
  }
}
