///|
fn atan2f_mpfr_case_groups() -> Array[Array[(UInt, UInt, UInt)]] {
  [
    atan2f_mpfr_cases_0(),
    atan2f_mpfr_cases_1(),
    atan2f_mpfr_cases_2(),
    atan2f_mpfr_cases_3(),
    atan2f_mpfr_cases_4(),
    atan2f_mpfr_cases_5(),
    atan2f_mpfr_cases_6(),
    atan2f_mpfr_cases_7(),
    atan2f_mpfr_cases_8(),
    atan2f_mpfr_cases_9(),
    atan2f_mpfr_cases_10(),
    atan2f_mpfr_cases_11(),
    atan2f_mpfr_cases_12(),
    atan2f_mpfr_cases_13(),
    atan2f_mpfr_cases_14(),
    atan2f_mpfr_cases_15(),
    atan2f_mpfr_cases_16(),
    atan2f_mpfr_cases_17(),
    atan2f_mpfr_cases_18(),
    atan2f_mpfr_cases_19(),
    atan2f_mpfr_cases_20(),
    atan2f_mpfr_cases_21(),
    atan2f_mpfr_cases_22(),
    atan2f_mpfr_cases_23(),
    atan2f_mpfr_cases_24(),
    atan2f_mpfr_cases_25(),
