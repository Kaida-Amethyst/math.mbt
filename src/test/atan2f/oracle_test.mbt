    atan2f_mpfr_cases_39(),
    atan2f_mpfr_cases_40(),
    atan2f_mpfr_cases_41(),
  ]
}

///|
fn atan2f_ordered_rank(bits : UInt) -> UInt {
  if (bits & 0x80000000U) != 0U {
    0x80000000U - (bits & 0x7fffffffU)
  } else {
    0x80000000U + bits
  }
}

///|
fn atan2f_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_rank = atan2f_ordered_rank(expect.reinterpret_as_uint())
  let actual_rank = atan2f_ordered_rank(actual.reinterpret_as_uint())
  if expect_rank >= actual_rank {
    expect_rank - actual_rank
  } else {
    actual_rank - expect_rank
  }
}

///|
test "atan2f agrees with the MPFR oracle within 2 ULP" {
  let mut maximum_error = 0U
  for cases in atan2f_mpfr_case_groups() {
    for triple in cases {
      let (y_bits, x_bits, expected_bits) = triple
      let y = Float::reinterpret_from_uint(y_bits)
      let x = Float::reinterpret_from_uint(x_bits)
      let expected = Float::reinterpret_from_uint(expected_bits)
      let actual = @math.atan2f(y, x)
      let error = atan2f_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 2U {
        println(
          "atan2f oracle mismatch: y_bits=\{y_bits}, x_bits=\{x_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 2U)
}

///|
test "atan2f stays in range and reflects exactly across the x-axis" {
  let negative_pi : Float = -3.1415927410e+00
  let positive_pi : Float = 3.1415927410e+00
  for cases in atan2f_mpfr_case_groups() {
    for triple in cases {
      let (y_bits, x_bits, _) = triple
      let y = Float::reinterpret_from_uint(y_bits)
      let x = Float::reinterpret_from_uint(x_bits)
      if !y.is_nan() && !x.is_nan() {
        let actual = @math.atan2f(y, x)
        assert_true(actual >= negative_pi && actual <= positive_pi)
        assert_eq(
          @math.atan2f(-y, x).reinterpret_as_uint(),
          (-actual).reinterpret_as_uint(),
        )
      }
    }
  }
}
