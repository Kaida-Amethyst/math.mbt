///|
fn sinh_mpfr_case_groups() -> Array[Array[(UInt64, UInt64)]] {
  [
    sinh_mpfr_cases_0(),
    sinh_mpfr_cases_1(),
    sinh_mpfr_cases_2(),
    sinh_mpfr_cases_3(),
    sinh_mpfr_cases_4(),
    sinh_mpfr_cases_5(),
    sinh_mpfr_cases_6(),
  ]
}

///|
fn sinh_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "sinh agrees with the MPFR oracle within 2 ULP" {
  let mut maximum_error = 0UL
  for cases in sinh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @math.sinh(input)
      let error = sinh_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 2UL {
        println(
          "sinh oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 2UL)
}

///|
test "MoonBit Core sinh stays within 2 ULP over the corpus" {
  for cases in sinh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @core_math.sinh(input)
      let error = sinh_oracle_ulp_error(expected, actual)
      if error > 2UL {
        println(
          "Core sinh oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
}

///|
test "sinh odd symmetry and monotonicity over the oracle corpus" {
  let mut previous : Double = 0.0
  let mut have_previous = false
  for cases in sinh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = input_bits.reinterpret_as_double()
      let actual = @math.sinh(input)
      assert_true(!actual.is_nan())
      let opposite = @math.sinh(-input)
      assert_eq(
        actual.reinterpret_as_uint64() ^ 0x8000000000000000UL,
        opposite.reinterpret_as_uint64(),
      )
      if have_previous {
        assert_true(previous <= actual)
      }
      previous = actual
      have_previous = true
    }
  }
}
