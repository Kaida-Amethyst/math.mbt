///|
fn acosf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    acosf_mpfr_cases_0(),
    acosf_mpfr_cases_1(),
    acosf_mpfr_cases_2(),
    acosf_mpfr_cases_3(),
    acosf_mpfr_cases_4(),
    acosf_mpfr_cases_5(),
    acosf_mpfr_cases_6(),
    acosf_mpfr_cases_7(),
    acosf_mpfr_cases_8(),
    acosf_mpfr_cases_9(),
    acosf_mpfr_cases_10(),
    acosf_mpfr_cases_11(),
    acosf_mpfr_cases_12(),
    acosf_mpfr_cases_13(),
  ]
}

///|
fn acosf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "acosf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in acosf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.acosf(input)
      let error = acosf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "acosf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core acosf meets the oracle bound over the corpus" {
  for cases in acosf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.acosf(input)
      assert_true(acosf_oracle_ulp_error(expected, actual) <= 1U)
    }
  }
}

///|
test "acosf is decreasing and remains in range over its real domain" {
  let mut previous : Float = 0.0
  let mut previous_input_bits = 0U
  let mut have_previous = false
  for cases in acosf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if (input_bits & 0x7fffffffU) <= 0x3f800000U {
        let actual = @math.acosf(input)
        assert_true(!actual.is_nan())
        assert_true(actual >= 0.0)
        assert_true(actual <= 3.1415927410125732)
        if have_previous {
          if previous < actual {
            println(
              "acosf monotonicity mismatch: previous_input_bits=\{previous_input_bits}, input_bits=\{input_bits}, previous_result_bits=\{previous.reinterpret_as_uint()}, result_bits=\{actual.reinterpret_as_uint()}",
            )
            assert_true(false)
          }
        }
        previous = actual
        previous_input_bits = input_bits
        have_previous = true
      }
    }
  }
}
