///|
fn cosf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    cosf_mpfr_cases_0(),
    cosf_mpfr_cases_1(),
    cosf_mpfr_cases_2(),
    cosf_mpfr_cases_3(),
    cosf_mpfr_cases_4(),
    cosf_mpfr_cases_5(),
    cosf_mpfr_cases_6(),
    cosf_mpfr_cases_7(),
    cosf_mpfr_cases_8(),
    cosf_mpfr_cases_9(),
    cosf_mpfr_cases_10(),
    cosf_mpfr_cases_11(),
    cosf_mpfr_cases_12(),
    cosf_mpfr_cases_13(),
    cosf_mpfr_cases_14(),
  ]
}

///|
fn cosf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "cosf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in cosf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.cosf(input)
      let error = cosf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "cosf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core cosf meets the oracle bound over the corpus" {
  for cases in cosf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.cosf(input)
      assert_true(cosf_oracle_ulp_error(expected, actual) <= 1U)
    }
  }
}

///|
test "cosf is even and remains in range over finite inputs" {
  for cases in cosf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if (input_bits & 0x7fffffffU) < 0x7f800000U {
        let actual = @math.cosf(input)
        assert_true(!actual.is_nan())
        let opposite = @math.cosf(-input)
        assert_eq(opposite.reinterpret_as_uint(), actual.reinterpret_as_uint())
        assert_true(actual >= -1.0)
        assert_true(actual <= 1.0)
      }
    }
  }
}
