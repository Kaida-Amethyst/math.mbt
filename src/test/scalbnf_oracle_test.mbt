///|
fn scalbnf_mpfr_case_groups() -> Array[Array[(UInt, Int, UInt)]] {
  [
    scalbnf_mpfr_cases_0(),
    scalbnf_mpfr_cases_1(),
    scalbnf_mpfr_cases_2(),
    scalbnf_mpfr_cases_3(),
    scalbnf_mpfr_cases_4(),
    scalbnf_mpfr_cases_5(),
    scalbnf_mpfr_cases_6(),
    scalbnf_mpfr_cases_7(),
  ]
}

///|
test "scalbnf agrees exactly with the MPFR oracle" {
  for cases in scalbnf_mpfr_case_groups() {
    for item in cases {
      let (input_bits, exponent, expected_bits) = item
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let actual_bits = @math.scalbnf(input, exponent).reinterpret_as_uint()
      if actual_bits != expected_bits {
        println(
          "scalbnf oracle mismatch: input_bits=\{input_bits}, exponent=\{exponent}, expected_bits=\{expected_bits}, actual_bits=\{actual_bits}",
        )
        assert_true(false)
      }
    }
  }
}

///|
test "scalbnf matches MoonBit Core over the oracle corpus" {
  for cases in scalbnf_mpfr_case_groups() {
    for item in cases {
      let (input_bits, exponent, _) = item
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      assert_eq(
        @math.scalbnf(input, exponent).reinterpret_as_uint(),
        @core_math.scalbnf(input, exponent).reinterpret_as_uint(),
      )
    }
  }
}
