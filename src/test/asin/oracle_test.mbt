///|
fn asin_mpfr_case_groups() -> Array[Array[(UInt64, UInt64)]] {
  [
    asin_mpfr_cases_0(),
    asin_mpfr_cases_1(),
    asin_mpfr_cases_2(),
    asin_mpfr_cases_3(),
    asin_mpfr_cases_4(),
    asin_mpfr_cases_5(),
    asin_mpfr_cases_6(),
    asin_mpfr_cases_7(),
    asin_mpfr_cases_8(),
    asin_mpfr_cases_9(),
    asin_mpfr_cases_10(),
    asin_mpfr_cases_11(),
    asin_mpfr_cases_12(),
    asin_mpfr_cases_13(),
    asin_mpfr_cases_14(),
    asin_mpfr_cases_15(),
    asin_mpfr_cases_16(),
    asin_mpfr_cases_17(),
    asin_mpfr_cases_18(),
    asin_mpfr_cases_19(),
    asin_mpfr_cases_20(),
    asin_mpfr_cases_21(),
    asin_mpfr_cases_22(),
    asin_mpfr_cases_23(),
    asin_mpfr_cases_24(),
    asin_mpfr_cases_25(),
    asin_mpfr_cases_26(),
    asin_mpfr_cases_27(),
    asin_mpfr_cases_28(),
    asin_mpfr_cases_29(),
    asin_mpfr_cases_30(),
    asin_mpfr_cases_31(),
    asin_mpfr_cases_32(),
    asin_mpfr_cases_33(),
    asin_mpfr_cases_34(),
  ]
}

///|
fn asin_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() && actual.is_nan() {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "asin agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0UL
  for cases in asin_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @math.asin(input)
      let error = asin_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1UL {
        println(
          "asin oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1UL)
}

///|
test "MoonBit Core asin meets the oracle bound over the corpus" {
  for cases in asin_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let expected = expected_bits.reinterpret_as_double()
      let actual = @core_math.asin(input_bits.reinterpret_as_double())
      assert_true(asin_oracle_ulp_error(expected, actual) <= 1UL)
    }
  }
}

///|
test "asin is monotonic and odd over its real domain" {
  let mut previous = 0.0
  let mut have_previous = false
  for cases in asin_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = input_bits.reinterpret_as_double()
      if input >= -1.0 && input <= 1.0 {
        let actual = @math.asin(input)
        assert_eq(
          @math.asin(-input).reinterpret_as_uint64(),
          (-actual).reinterpret_as_uint64(),
        )
        if have_previous {
          assert_true(previous <= actual)
        }
        previous = actual
        have_previous = true
      }
    }
  }
}
