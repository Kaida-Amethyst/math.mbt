///|
fn coshf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    coshf_mpfr_cases_0(),
    coshf_mpfr_cases_1(),
    coshf_mpfr_cases_2(),
    coshf_mpfr_cases_3(),
    coshf_mpfr_cases_4(),
    coshf_mpfr_cases_5(),
    coshf_mpfr_cases_6(),
  ]
}

///|
fn coshf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "coshf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in coshf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.coshf(input)
      let error = coshf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "coshf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core coshf meets the oracle bound over the corpus" {
  for cases in coshf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.coshf(input)
      assert_true(coshf_oracle_ulp_error(expected, actual) <= 1U)
    }
  }
}

///|
test "coshf range and symmetry over the oracle corpus" {
  for cases in coshf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let actual = @math.coshf(input)
      assert_true(!actual.is_nan())
      assert_true(actual >= 1.0)
      let opposite = @math.coshf(-input)
      assert_eq(opposite.reinterpret_as_uint(), actual.reinterpret_as_uint())
    }
  }
}
