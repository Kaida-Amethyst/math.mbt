///|
fn log1pf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    log1pf_mpfr_cases_0(),
    log1pf_mpfr_cases_1(),
    log1pf_mpfr_cases_2(),
    log1pf_mpfr_cases_3(),
    log1pf_mpfr_cases_4(),
    log1pf_mpfr_cases_5(),
    log1pf_mpfr_cases_6(),
    log1pf_mpfr_cases_7(),
    log1pf_mpfr_cases_8(),
    log1pf_mpfr_cases_9(),
    log1pf_mpfr_cases_10(),
    log1pf_mpfr_cases_11(),
    log1pf_mpfr_cases_12(),
    log1pf_mpfr_cases_13(),
    log1pf_mpfr_cases_14(),
    log1pf_mpfr_cases_15(),
    log1pf_mpfr_cases_16(),
  ]
}

///|
fn log1pf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "log1pf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in log1pf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.log1pf(input)
      let error = log1pf_oracle_ulp_error(expected, actual)
      assert_eq(
        @math.ln_1pf(input).reinterpret_as_uint(),
        actual.reinterpret_as_uint(),
      )
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "log1pf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core log1pf meets the oracle bound over the corpus" {
  for cases in log1pf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.ln_1pf(input)
      assert_true(log1pf_oracle_ulp_error(expected, actual) <= 1U)
    }
  }
}

///|
test "log1pf is monotonic over its real domain" {
  let mut previous : Float = 0.0
  let mut have_previous = false
  for cases in log1pf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if input >= -1.0 {
        let actual = @math.log1pf(input)
        assert_true(!actual.is_nan())
        if have_previous {
          assert_true(previous <= actual)
        }
        previous = actual
        have_previous = true
      }
    }
  }
}
