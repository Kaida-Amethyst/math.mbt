///|
fn atan_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() && actual.is_nan() {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "atan agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0UL
  for cases in atan_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @math.atan(input)
      let error = atan_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1UL {
        println(
          "atan oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1UL)
}

///|
test "MoonBit Core atan meets the oracle bound over the corpus" {
  for cases in atan_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let expected = expected_bits.reinterpret_as_double()
      let actual = @core_math.atan(input_bits.reinterpret_as_double())
      assert_true(atan_oracle_ulp_error(expected, actual) <= 1UL)
    }
  }
}

///|
test "atan is monotonic and odd over the extended real line" {
  let mut previous = 0.0
  let mut have_previous = false
  for cases in atan_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = input_bits.reinterpret_as_double()
      let actual = @math.atan(input)
      assert_eq(
        @math.atan(-input).reinterpret_as_uint64(),
        (-actual).reinterpret_as_uint64(),
      )
      if have_previous {
        assert_true(previous <= actual)
      }
      previous = actual
      have_previous = true
    }
  }
}
