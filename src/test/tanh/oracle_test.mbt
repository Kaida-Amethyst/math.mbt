    (0x7efd510cf817ce3eUL, 0x3ff0000000000000UL),
    (0x7f037539d7e0301aUL, 0x3ff0000000000000UL),
    (0x7f18a073732c0aacUL, 0x3ff0000000000000UL),
    (0x7f27cf1d4f6bf169UL, 0x3ff0000000000000UL),
    (0x7f620361ae8dfd42UL, 0x3ff0000000000000UL),
    (0x7f6f3510290d02f8UL, 0x3ff0000000000000UL),
    (0x7f864c882117c6e1UL, 0x3ff0000000000000UL),
    (0x7f953c47bcd0aca1UL, 0x3ff0000000000000UL),
    (0x7fb811ab81e4ee2bUL, 0x3ff0000000000000UL),
    (0x7fc7384efd27c153UL, 0x3ff0000000000000UL),
    (0x7fcb22a1d6f2b03bUL, 0x3ff0000000000000UL),
    (0x7fcc6f2ba380e2f1UL, 0x3ff0000000000000UL),
    (0x7fd38125036ba74dUL, 0x3ff0000000000000UL),
    (0x7feffffffffffffdUL, 0x3ff0000000000000UL),
    (0x7feffffffffffffeUL, 0x3ff0000000000000UL),
    (0x7fefffffffffffffUL, 0x3ff0000000000000UL),
    (0x7ff0000000000000UL, 0x3ff0000000000000UL),
  ]
}

///|
fn tanh_mpfr_case_groups() -> Array[Array[(UInt64, UInt64)]] {
  [
    tanh_mpfr_cases_0(),
    tanh_mpfr_cases_1(),
    tanh_mpfr_cases_2(),
    tanh_mpfr_cases_3(),
    tanh_mpfr_cases_4(),
    tanh_mpfr_cases_5(),
    tanh_mpfr_cases_6(),
  ]
}

///|
fn tanh_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "tanh agrees with the MPFR oracle within 2 ULP" {
  let mut maximum_error = 0UL
  for cases in tanh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @math.tanh(input)
      let error = tanh_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 2UL {
        println(
          "tanh oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 2UL)
}

///|
test "MoonBit Core tanh stays within 2 ULP over the corpus" {
  for cases in tanh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @core_math.tanh(input)
      let error = tanh_oracle_ulp_error(expected, actual)
      if error > 2UL {
        println(
          "Core tanh oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
}

///|
test "tanh odd symmetry and monotonicity over the oracle corpus" {
  let mut previous : Double = 0.0
  let mut have_previous = false
  for cases in tanh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = input_bits.reinterpret_as_double()
      let actual = @math.tanh(input)
      assert_true(!actual.is_nan())
      assert_true(actual >= -1.0)
      assert_true(actual <= 1.0)
      let opposite = @math.tanh(-input)
      assert_eq(
        actual.reinterpret_as_uint64() ^ 0x8000000000000000UL,
        opposite.reinterpret_as_uint64(),
      )
      if have_previous {
        assert_true(previous <= actual)
      }
      previous = actual
      have_previous = true
    }
  }
}
