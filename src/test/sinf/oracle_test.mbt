}

///|
fn sinf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    sinf_mpfr_cases_0(),
    sinf_mpfr_cases_1(),
    sinf_mpfr_cases_2(),
    sinf_mpfr_cases_3(),
    sinf_mpfr_cases_4(),
    sinf_mpfr_cases_5(),
    sinf_mpfr_cases_6(),
    sinf_mpfr_cases_7(),
    sinf_mpfr_cases_8(),
    sinf_mpfr_cases_9(),
    sinf_mpfr_cases_10(),
    sinf_mpfr_cases_11(),
    sinf_mpfr_cases_12(),
    sinf_mpfr_cases_13(),
    sinf_mpfr_cases_14(),
  ]
}

///|
fn sinf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "sinf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in sinf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.sinf(input)
      let error = sinf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "sinf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core sinf meets the oracle bound over the corpus" {
  for cases in sinf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.sinf(input)
      assert_true(sinf_oracle_ulp_error(expected, actual) <= 1U)
    }
  }
}

///|
test "sinf is odd and remains in range over finite inputs" {
  for cases in sinf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if (input_bits & 0x7fffffffU) < 0x7f800000U {
        let actual = @math.sinf(input)
        assert_true(!actual.is_nan())
        let opposite = @math.sinf(-input)
        assert_eq(
          opposite.reinterpret_as_uint(),
          (-actual).reinterpret_as_uint(),
        )
        assert_true(actual >= -1.0)
        assert_true(actual <= 1.0)
      }
    }
  }
}
