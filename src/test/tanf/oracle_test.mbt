///|
fn tanf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    tanf_mpfr_cases_0(),
    tanf_mpfr_cases_1(),
    tanf_mpfr_cases_2(),
    tanf_mpfr_cases_3(),
    tanf_mpfr_cases_4(),
    tanf_mpfr_cases_5(),
    tanf_mpfr_cases_6(),
    tanf_mpfr_cases_7(),
    tanf_mpfr_cases_8(),
    tanf_mpfr_cases_9(),
    tanf_mpfr_cases_10(),
    tanf_mpfr_cases_11(),
    tanf_mpfr_cases_12(),
    tanf_mpfr_cases_13(),
    tanf_mpfr_cases_14(),
  ]
}

///|
fn tanf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "tanf agrees with the MPFR oracle within 2 ULP" {
  let mut maximum_error = 0U
  for cases in tanf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.tanf(input)
      let error = tanf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 2U {
        println(
          "tanf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 2U)
}

///|
test "MoonBit Core tanf meets the oracle bound over the corpus" {
  for cases in tanf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @core_math.tanf(input)
      assert_true(tanf_oracle_ulp_error(expected, actual) <= 2U)
    }
  }
}

///|
test "tanf is odd over finite inputs" {
  for cases in tanf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if (input_bits & 0x7fffffffU) < 0x7f800000U {
        let actual = @math.tanf(input)
        assert_true(!actual.is_nan())
        let opposite = @math.tanf(-input)
        assert_eq(
          opposite.reinterpret_as_uint(),
          (-actual).reinterpret_as_uint(),
        )
      }
    }
  }
}
