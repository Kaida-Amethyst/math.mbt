///|
fn cosh_mpfr_case_groups() -> Array[Array[(UInt64, UInt64)]] {
  [
    cosh_mpfr_cases_0(),
    cosh_mpfr_cases_1(),
    cosh_mpfr_cases_2(),
    cosh_mpfr_cases_3(),
    cosh_mpfr_cases_4(),
    cosh_mpfr_cases_5(),
    cosh_mpfr_cases_6(),
  ]
}

///|
fn cosh_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "cosh agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0UL
  for cases in cosh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @math.cosh(input)
      let error = cosh_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1UL {
        println(
          "cosh oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1UL)
}

///|
test "MoonBit Core cosh stays within 2 ULP over the corpus" {
  for cases in cosh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @core_math.cosh(input)
      let error = cosh_oracle_ulp_error(expected, actual)
      if error > 2UL {
        println(
          "Core cosh oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
}

///|
test "cosh even symmetry and range over the oracle corpus" {
  for cases in cosh_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = input_bits.reinterpret_as_double()
      let actual = @math.cosh(input)
      assert_true(!actual.is_nan())
      assert_true(actual >= 1.0)
      let opposite = @math.cosh(-input)
      assert_eq(
        actual.reinterpret_as_uint64(),
        opposite.reinterpret_as_uint64(),
      )
    }
  }
}
