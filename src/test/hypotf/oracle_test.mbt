    hypotf_mpfr_cases_27(),
    hypotf_mpfr_cases_28(),
    hypotf_mpfr_cases_29(),
    hypotf_mpfr_cases_30(),
    hypotf_mpfr_cases_31(),
    hypotf_mpfr_cases_32(),
    hypotf_mpfr_cases_33(),
    hypotf_mpfr_cases_34(),
    hypotf_mpfr_cases_35(),
  ]
}

///|
fn hypotf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "hypotf agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0U
  for cases in hypotf_mpfr_case_groups() {
    for triple in cases {
      let (x_bits, y_bits, expected_bits) = triple
      let x = Float::reinterpret_from_uint(x_bits)
      let y = Float::reinterpret_from_uint(y_bits)
      let expected = Float::reinterpret_from_uint(expected_bits)
      let actual = @math.hypotf(x, y)
      let error = hypotf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1U {
        println(
          "hypotf oracle mismatch: x_bits=\{x_bits}, y_bits=\{y_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1U)
}

///|
test "MoonBit Core hypotf comparison over finite-reference results" {
  for cases in hypotf_mpfr_case_groups() {
    for triple in cases {
      let (x_bits, y_bits, expected_bits) = triple
      let x = Float::reinterpret_from_uint(x_bits)
      let y = Float::reinterpret_from_uint(y_bits)
      let expected = Float::reinterpret_from_uint(expected_bits)
      let actual = @core_math.hypotf(x, y)
      if !expected.is_inf() {
        assert_true(hypotf_oracle_ulp_error(expected, actual) <= 2U)
      } else if x.is_inf() || y.is_inf() {
        assert_true(actual.is_inf())
      }
    }
  }
}

///|
test "hypotf is symmetric, sign-invariant, and no smaller than either magnitude" {
  for cases in hypotf_mpfr_case_groups() {
    for triple in cases {
      let (x_bits, y_bits, _) = triple
      let x = Float::reinterpret_from_uint(x_bits)
      let y = Float::reinterpret_from_uint(y_bits)
      if !x.is_nan() && !y.is_nan() {
        let actual = @math.hypotf(x, y)
        assert_eq(
          @math.hypotf(y, x).reinterpret_as_uint(),
          actual.reinterpret_as_uint(),
        )
        assert_eq(
          @math.hypotf(-x, -y).reinterpret_as_uint(),
          actual.reinterpret_as_uint(),
        )
        assert_true(actual >= x.abs())
        assert_true(actual >= y.abs())
      }
    }
  }
}
