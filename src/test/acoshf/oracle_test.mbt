///|
fn acoshf_mpfr_case_groups() -> Array[Array[(UInt, UInt)]] {
  [
    acoshf_mpfr_cases_0(),
    acoshf_mpfr_cases_1(),
    acoshf_mpfr_cases_2(),
    acoshf_mpfr_cases_3(),
    acoshf_mpfr_cases_4(),
    acoshf_mpfr_cases_5(),
    acoshf_mpfr_cases_6(),
    acoshf_mpfr_cases_7(),
    acoshf_mpfr_cases_8(),
    acoshf_mpfr_cases_9(),
    acoshf_mpfr_cases_10(),
    acoshf_mpfr_cases_11(),
    acoshf_mpfr_cases_12(),
    acoshf_mpfr_cases_13(),
    acoshf_mpfr_cases_14(),
    acoshf_mpfr_cases_15(),
  ]
}

///|
fn acoshf_oracle_ulp_error(expect : Float, actual : Float) -> UInt {
  if expect == actual {
    return 0U
  }
  if expect.is_nan() && actual.is_nan() {
    return 0U
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffU
  }
  let expect_bits = expect.reinterpret_as_uint()
  let actual_bits = actual.reinterpret_as_uint()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "acoshf agrees with the MPFR oracle within 2 ULP" {
  let mut maximum_error = 0U
  for cases in acoshf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      let actual = @math.acoshf(input)
      let error = acoshf_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 2U {
        println(
          "acoshf oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 2U)
}

///|
test "MoonBit Core acoshf meets the oracle bound on its unaffected range" {
  for cases in acoshf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      let expected = Float::reinterpret_from_int(
        expected_bits.reinterpret_as_int(),
      )
      if input >= 1.0 && input < 4096.0 {
        let actual = @core_math.acoshf(input)
        assert_true(acoshf_oracle_ulp_error(expected, actual) <= 2U)
      }
    }
  }
}

///|
test "acoshf is monotonic over its real domain" {
  let mut previous : Float = 0.0
  let mut have_previous = false
  for cases in acoshf_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = Float::reinterpret_from_int(input_bits.reinterpret_as_int())
      if input >= 1.0 {
        let actual = @math.acoshf(input)
        assert_true(!actual.is_nan())
        if have_previous {
          assert_true(previous <= actual)
        }
        previous = actual
        have_previous = true
      }
    }
  }
}
