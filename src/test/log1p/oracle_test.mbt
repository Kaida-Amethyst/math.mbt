///|
fn log1p_mpfr_case_groups() -> Array[Array[(UInt64, UInt64)]] {
  [
    log1p_mpfr_cases_0(),
    log1p_mpfr_cases_1(),
    log1p_mpfr_cases_2(),
    log1p_mpfr_cases_3(),
    log1p_mpfr_cases_4(),
    log1p_mpfr_cases_5(),
    log1p_mpfr_cases_6(),
    log1p_mpfr_cases_7(),
    log1p_mpfr_cases_8(),
    log1p_mpfr_cases_9(),
    log1p_mpfr_cases_10(),
    log1p_mpfr_cases_11(),
    log1p_mpfr_cases_12(),
    log1p_mpfr_cases_13(),
    log1p_mpfr_cases_14(),
    log1p_mpfr_cases_15(),
    log1p_mpfr_cases_16(),
    log1p_mpfr_cases_17(),
    log1p_mpfr_cases_18(),
    log1p_mpfr_cases_19(),
    log1p_mpfr_cases_20(),
    log1p_mpfr_cases_21(),
    log1p_mpfr_cases_22(),
    log1p_mpfr_cases_23(),
    log1p_mpfr_cases_24(),
    log1p_mpfr_cases_25(),
    log1p_mpfr_cases_26(),
    log1p_mpfr_cases_27(),
    log1p_mpfr_cases_28(),
    log1p_mpfr_cases_29(),
    log1p_mpfr_cases_30(),
    log1p_mpfr_cases_31(),
    log1p_mpfr_cases_32(),
    log1p_mpfr_cases_33(),
    log1p_mpfr_cases_34(),
    log1p_mpfr_cases_35(),
    log1p_mpfr_cases_36(),
  ]
}

///|
fn log1p_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() && actual.is_nan() {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "log1p agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0UL
  for cases in log1p_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @math.log1p(input)
      assert_eq(
        @math.ln_1p(input).reinterpret_as_uint64(),
        actual.reinterpret_as_uint64(),
      )
      let error = log1p_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1UL {
        println(
          "log1p oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1UL)
}

///|
test "MoonBit Core ln_1p stays within 2 ULP over the corpus" {
  for cases in log1p_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @core_math.ln_1p(input)
      let error = log1p_oracle_ulp_error(expected, actual)
      if error > 2UL {
        println(
          "Core ln_1p oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
}

///|
test "log1p is monotonic over its real domain" {
  let mut previous : Double = 0.0
  let mut have_previous = false
  for cases in log1p_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = input_bits.reinterpret_as_double()
      if input >= -1.0 {
        let actual = @math.log1p(input)
        assert_true(!actual.is_nan())
        if have_previous {
          assert_true(previous <= actual)
        }
        previous = actual
        have_previous = true
      }
    }
  }
}
