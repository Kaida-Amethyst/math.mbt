///|
fn scalbn_mpfr_case_groups() -> Array[Array[(UInt64, Int, UInt64)]] {
  [
    scalbn_mpfr_cases_0(),
    scalbn_mpfr_cases_1(),
    scalbn_mpfr_cases_2(),
    scalbn_mpfr_cases_3(),
    scalbn_mpfr_cases_4(),
    scalbn_mpfr_cases_5(),
    scalbn_mpfr_cases_6(),
    scalbn_mpfr_cases_7(),
  ]
}

///|
test "scalbn agrees exactly with the MPFR oracle" {
  for cases in scalbn_mpfr_case_groups() {
    for item in cases {
      let (input_bits, exponent, expected_bits) = item
      let actual_bits = @math.scalbn(
        input_bits.reinterpret_as_double(),
        exponent,
      ).reinterpret_as_uint64()
      if actual_bits != expected_bits {
        println(
          "scalbn oracle mismatch: input_bits=\{input_bits}, exponent=\{exponent}, expected_bits=\{expected_bits}, actual_bits=\{actual_bits}",
        )
        assert_true(false)
      }
    }
  }
}

///|
test "ldexp agrees exactly with the MPFR oracle" {
  for cases in scalbn_mpfr_case_groups() {
    for item in cases {
      let (input_bits, exponent, expected_bits) = item
      let actual_bits = @math.ldexp(
        input_bits.reinterpret_as_double(),
        exponent,
      ).reinterpret_as_uint64()
      if actual_bits != expected_bits {
        println(
          "ldexp oracle mismatch: input_bits=\{input_bits}, exponent=\{exponent}, expected_bits=\{expected_bits}, actual_bits=\{actual_bits}",
        )
        assert_true(false)
      }
    }
  }
}

///|
test "scalbn matches MoonBit Core over the oracle corpus" {
  for cases in scalbn_mpfr_case_groups() {
    for item in cases {
      let (input_bits, exponent, _) = item
      let input = input_bits.reinterpret_as_double()
      assert_eq(
        @math.scalbn(input, exponent).reinterpret_as_uint64(),
        @core_math.scalbn(input, exponent).reinterpret_as_uint64(),
      )
    }
  }
}
