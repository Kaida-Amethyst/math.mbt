///|
fn acos_mpfr_case_groups() -> Array[Array[(UInt64, UInt64)]] {
  [
    acos_mpfr_cases_0(),
    acos_mpfr_cases_1(),
    acos_mpfr_cases_2(),
    acos_mpfr_cases_3(),
    acos_mpfr_cases_4(),
    acos_mpfr_cases_5(),
    acos_mpfr_cases_6(),
    acos_mpfr_cases_7(),
    acos_mpfr_cases_8(),
    acos_mpfr_cases_9(),
    acos_mpfr_cases_10(),
    acos_mpfr_cases_11(),
    acos_mpfr_cases_12(),
    acos_mpfr_cases_13(),
    acos_mpfr_cases_14(),
    acos_mpfr_cases_15(),
    acos_mpfr_cases_16(),
    acos_mpfr_cases_17(),
    acos_mpfr_cases_18(),
    acos_mpfr_cases_19(),
    acos_mpfr_cases_20(),
    acos_mpfr_cases_21(),
    acos_mpfr_cases_22(),
    acos_mpfr_cases_23(),
    acos_mpfr_cases_24(),
    acos_mpfr_cases_25(),
    acos_mpfr_cases_26(),
    acos_mpfr_cases_27(),
    acos_mpfr_cases_28(),
    acos_mpfr_cases_29(),
    acos_mpfr_cases_30(),
    acos_mpfr_cases_31(),
    acos_mpfr_cases_32(),
    acos_mpfr_cases_33(),
    acos_mpfr_cases_34(),
  ]
}

///|
fn acos_oracle_ulp_error(expect : Double, actual : Double) -> UInt64 {
  if expect == actual {
    return 0UL
  }
  if expect.is_nan() && actual.is_nan() {
    return 0UL
  }
  if expect.is_nan() || actual.is_nan() || expect.is_inf() || actual.is_inf() {
    return 0xffffffffffffffffUL
  }
  let expect_bits = expect.reinterpret_as_uint64()
  let actual_bits = actual.reinterpret_as_uint64()
  if expect_bits >= actual_bits {
    expect_bits - actual_bits
  } else {
    actual_bits - expect_bits
  }
}

///|
test "acos agrees with the MPFR oracle within 1 ULP" {
  let mut maximum_error = 0UL
  for cases in acos_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let input = input_bits.reinterpret_as_double()
      let expected = expected_bits.reinterpret_as_double()
      let actual = @math.acos(input)
      let error = acos_oracle_ulp_error(expected, actual)
      if error > maximum_error {
        maximum_error = error
      }
      if error > 1UL {
        println(
          "acos oracle mismatch: input_bits=\{input_bits}, expected_bits=\{expected_bits}, actual_bits=\{actual.reinterpret_as_uint64()}, ulp=\{error}",
        )
        assert_true(false)
      }
    }
  }
  assert_true(maximum_error <= 1UL)
}

///|
test "MoonBit Core acos meets the oracle bound over the corpus" {
  for cases in acos_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, expected_bits) = pair
      let expected = expected_bits.reinterpret_as_double()
      let actual = @core_math.acos(input_bits.reinterpret_as_double())
      assert_true(acos_oracle_ulp_error(expected, actual) <= 1UL)
    }
  }
}

///|
test "acos is decreasing and stays in range over its real domain" {
  let mut previous = 0.0
  let mut have_previous = false
  for cases in acos_mpfr_case_groups() {
    for pair in cases {
      let (input_bits, _) = pair
      let input = input_bits.reinterpret_as_double()
      if input >= -1.0 && input <= 1.0 {
        let actual = @math.acos(input)
        assert_true(actual >= 0.0 && actual <= 3.1415926535897931160)
        if have_previous {
          assert_true(previous >= actual)
        }
        previous = actual
        have_previous = true
      }
    }
  }
}
